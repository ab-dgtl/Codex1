# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=replace-with-a-random-token-at-least-24-characters
DATABASE_PATH=/data/agent.db
POLL_SECONDS=2
# Optional Telegram; comma-separated numeric user IDs, deny all when empty
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Optional paid HTTP provider; exact host allowlist; HTTPS only
PROVIDER_URL=
PROVIDER_ALLOWED_HOSTS=
PROVIDER_API_KEY=
# Optional AI analysis, OpenAI-compatible chat completions
LLM_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=
